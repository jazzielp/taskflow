# ---------------------------------------------------------------------------
# TaskFlow — variables de entorno de desarrollo
#
# Copia este archivo a `.env` en la raíz del monorepo:
#     cp .env.example .env
#
# La raíz es el único lugar donde viven los secretos de desarrollo. `apps/api`
# carga primero este archivo y luego, si existe, `apps/api/.env` (que puede
# sobrescribir valores puntuales).
#
# NUNCA pongas estas variables en apps/web ni en apps/mobile: todo lo que se
# envía al navegador o al móvil es visible para el usuario.
# ---------------------------------------------------------------------------

# --- Base de datos (usada por Prisma y por la API) ---
DATABASE_URL="postgresql://taskflow:taskflow@localhost:5432/taskflow_dev?schema=public"

# Base de datos exclusiva para los tests de integración.
# Debe ser DISTINTA de la de desarrollo: los tests borran datos.
TEST_DATABASE_URL="postgresql://taskflow:taskflow@localhost:5432/taskflow_test?schema=public"

# OPCIONAL. Base de datos temporal que `prisma migrate dev` usa para validar
# las migraciones antes de aplicarlas.
#
# Solo hace falta si el usuario de PostgreSQL NO tiene el permiso CREATEDB: en
# ese caso Prisma no puede crear la base por su cuenta y hay que dársela hecha.
#   CREATE DATABASE taskflow_shadow OWNER taskflow;
#
# `prisma migrate deploy` (el comando de producción) no la utiliza nunca.
SHADOW_DATABASE_URL="postgresql://taskflow:taskflow@localhost:5432/taskflow_shadow?schema=public"

# --- API ---
PORT=3000
NODE_ENV=development

# Secreto para firmar los JWT. En producción usa un valor largo y aleatorio:
#     openssl rand -base64 48
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio-de-desarrollo"
JWT_EXPIRES_IN="7d"

# Orígenes permitidos por CORS, separados por comas.
CORS_ORIGIN="http://localhost:5173"

# --- Clientes (se añadirán en fases posteriores) ---
# apps/web/.env    -> VITE_API_URL=http://localhost:3000/api
# apps/mobile/.env -> EXPO_PUBLIC_API_URL=http://localhost:3000/api
