{
  "name": "taskflow",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml}\"",
    "db:generate": "pnpm --filter @taskflow/database run generate",
    "db:migrate": "pnpm --filter @taskflow/database run migrate",
    "db:migrate:deploy": "pnpm --filter @taskflow/database run migrate:deploy",
    "db:reset": "pnpm --filter @taskflow/database run reset",
    "db:seed": "pnpm --filter @taskflow/database run seed",
    "db:studio": "pnpm --filter @taskflow/database run studio"
  },
  "devDependencies": {
    "@taskflow/prettier-config": "workspace:*",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "^5.9.0"
  },
  "prettier": "@taskflow/prettier-config"
}
